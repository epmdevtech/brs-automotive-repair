# Variáveis de ambiente do briefing da Master (EPM DevTech)
#
# Copie para `.env` (local) ou configure no painel da Vercel (previsão/produção).
# NUNCA versione valores reais. NUNCA prefixe chave privilegiada com VITE_.

# --- Supabase (servidor) -------------------------------------------------
# URL do projeto Supabase (https://<ref>.supabase.co)
SUPABASE_URL=

# Chave anônima (pública) do Supabase.
# Pode ser exposta ao navegador com prefixo VITE_ quando necessário.
SUPABASE_ANON_KEY=

# Chave privilegiada (service_role). EXCLUSIVA DO SERVIDOR.
# Deixe vazia no ambiente de preview até a configuração ser validada.
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase (navegador) -----------------------------------------------
# Exposta ao bundle do cliente. Nunca use a service_role aqui.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Storage -------------------------------------------------------------
# Nome do bucket privado usado pelo briefing.
SUPABASE_BRIEFING_BUCKET=master-briefing-private

# --- Testes E2E (Playwright) --------------------------------------------
# Conta de teste do percurso das 15 etapas do briefing.
# Com SUPABASE_SERVICE_ROLE_KEY preenchido, o teste cria/garante a conta já
# confirmada pela Admin API do Supabase.
E2E_EMAIL=qa.brs@masterchapeacao.com.br
E2E_PASSWORD=QaBrs-2026!

# --- Aplicação -----------------------------------------------------------
# Nome exibido no e-mail de autenticação do Supabase.
VITE_APP_ENV=development
